# Copy this file to .env.local and fill in the values from your Supabase project.
# Only the publishable values belong in the app. Never put a service role key here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional: set to 1 to hide the Audius catalog in the app.
# EXPO_PUBLIC_DISABLE_AUDIUS=1

# Stripe payment link for the landing page pricing button. If empty, the button shows "Checkout is not available right now."
EXPO_PUBLIC_STRIPE_PAYMENT_LINK=
